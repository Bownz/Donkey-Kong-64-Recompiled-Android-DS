<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- RT64 renders through Vulkan only; there is no GLES fallback.
         0x00401000 = Vulkan 1.1, the minimum the plume backend's feature set needs. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00401000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="0"
        android:required="true" />

    <!-- Input: none of these are required, so phones without a pad can still install. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Controller rumble (SDL haptics). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- SDL's HIDAPI driver for Bluetooth controllers. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The in-game mod browser downloads mods over HTTPS (libcurl). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No storage permission is needed: the ROM is chosen with the system document
         picker and copied into app-specific storage. -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:isGame="true"
        android:appCategory="game"
        android:hasFragileUserData="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- SDL routes window, input and lifecycle through this single activity.
             configChanges keeps Android from restarting it (and tearing down the
             native renderer) on rotation, keyboard or controller changes. -->
        <activity
            android:name=".DK64Activity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Let SDL notice controllers attached over USB while running. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>

        <!-- Let the app use the full display on tall/notched screens. -->
        <meta-data android:name="android.max_aspect" android:value="2.4" />
    </application>
</manifest>
