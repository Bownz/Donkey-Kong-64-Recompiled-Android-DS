 uint EndianSwapUINT16(uint i) {
-    return ((i << 8) & 0xFF00) | ((i >> 8) & 0xFF);
+    // Some Qualcomm Vulkan compilers fail to build compute shaders with the
+    // OR-of-two-masked-shifts form (vkCreateComputePipelines -> VK_ERROR_UNKNOWN), leaving the
+    // framebuffer read/write pipelines null. Masking once after the OR is equivalent for 16-bit
+    // input and compiles everywhere (see Goemon64Recomp-Android's RT64).
+    i &= 0xFFFFu;
+    return (i << 8 | i >> 8) & 0xFFFFu;
 }
 
