+            set_padding(16.0f);
+#endif
+            set_cursor(Cursor::Pointer);
+            set_focusable(true);
+            set_tab_index_auto();
+            add_style(&hover_style, { hover_state });
+            add_style(&focus_style, { focus_state });
+            ContextId context = get_current_context();
+            Label *name = context.create_element<Label>(this, text, theme::Typography::LabelMD);
+            name->set_text_transform(TextTransform::Uppercase);
+            name->set_font_weight(700);
+            name->set_color(Color{255, 244, 214, 255});
+            Label *arrow = context.create_element<Label>(this, "\u203A", theme::Typography::LabelMD);
+            arrow->set_font_weight(700);
+            arrow->set_color(Color{249, 214, 72, 255});
