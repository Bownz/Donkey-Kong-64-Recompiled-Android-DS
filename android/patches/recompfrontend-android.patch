+// Which kind of face buttons the connected controller has (used for the button symbols).
+// SDL knows the common families (Xbox, PlayStation, Switch) from its controller database; for
+// others the name decides (AYN's "Odin Controller" is the Thor/Odin in its Nintendo mode).
+static FaceButtonStyle face_button_style() {
+    for (int i = 0; i < SDL_NumJoysticks(); i++) {
+        if (!SDL_IsGameController(i)) {
+            continue;
+        }
+        // Like SDL3's SDL_GetGamepadButtonLabel: a "face:" field or the button-labels hint
+        // in the controller's mapping wins, then the controller type, then (our addition)
+        // the name.
+        if (char *mapping = SDL_GameControllerMappingForDeviceIndex(i)) {
+            std::string m = mapping;
+            SDL_free(mapping);
+            size_t face = m.find("face:");
+            if (face != std::string::npos) {
+                std::string value = m.substr(face + 5, 4);
+                if (value == "sony") return FaceButtonStyle::PlayStation;
+                if (value == "bayx") return FaceButtonStyle::Nintendo;
+                if (value == "abxy") return FaceButtonStyle::Xbox;
+            }
+            if (m.find("SDL_GAMECONTROLLER_USE_BUTTON_LABELS") != std::string::npos) {
+                return FaceButtonStyle::Nintendo;
+            }
+        }
+        switch (SDL_GameControllerTypeForIndex(i)) {
+        case SDL_CONTROLLER_TYPE_NINTENDO_SWITCH_PRO:
+            return FaceButtonStyle::Nintendo;
+        case SDL_CONTROLLER_TYPE_PS3:
+        case SDL_CONTROLLER_TYPE_PS4:
+        case SDL_CONTROLLER_TYPE_PS5:
+            return FaceButtonStyle::PlayStation;
+        default:
+            break;
+        }
+        const char *name = SDL_GameControllerNameForIndex(i);
+        if (name != nullptr) {
+            std::string n = name;
+            for (auto &ch : n) {
+                ch = static_cast<char>(tolower(static_cast<unsigned char>(ch)));
+            }
+            if (n.find("odin") != std::string::npos || n.find("nintendo") != std::string::npos
+                    || n.find("switch") != std::string::npos) {
+                return FaceButtonStyle::Nintendo;
+            }
+            if (n.find("playstation") != std::string::npos || n.find("dualshock") != std::string::npos
+                    || n.find("dualsense") != std::string::npos || n.find("wireless controller") == 0) {
+                return FaceButtonStyle::PlayStation;
+            }
+        }
+        return FaceButtonStyle::Xbox;   // the first controller decides
+    }
+    return FaceButtonStyle::Xbox;
+}
+
+FaceButtonStyle get_face_button_style() {
+    return face_button_style();
+}
+
+bool controller_uses_nintendo_layout() {
+    return face_button_style() == FaceButtonStyle::Nintendo;
+}
+
+std::string connected_controller_name() {
+    for (int i = 0; i < SDL_NumJoysticks(); i++) {
+        if (SDL_IsGameController(i)) {
+            const char *name = SDL_GameControllerNameForIndex(i);
+            return name != nullptr ? name : "Controller";
+        }
+    }
+    return "";
+}
