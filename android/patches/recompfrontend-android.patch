+        if (enum_opt.options[i].value == current) {
+            index = i;
+            break;
+        }
+    }
+    // The next choice that isn't disabled, wrapping round.
+    for (int tries = 0; tries < count; tries++) {
+        index = (index + direction + count) % count;
+        if (!config->get_enum_option_disabled(option_index, uint32_t(index))) {
+            set_option_value(option_id, enum_opt.options[index].value);
