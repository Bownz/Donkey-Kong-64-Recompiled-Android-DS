+namespace {
+    SDL_Window *android_game_window = nullptr;
+
+    // The ANativeWindow currently backing the game window. SDL replaces it when Android
+    // recreates the surface (e.g. after the ROM file picker), and clears it while the app
+    // has no surface.
+    ANativeWindow *android_current_native_window() {
+        if (android_game_window == nullptr) {
+            return nullptr;
+        }
+        SDL_SysWMinfo wm_info;
+        SDL_VERSION(&wm_info.version);
+        if (!SDL_GetWindowWMInfo(android_game_window, &wm_info)) {
+            return nullptr;
+        }
+        return wm_info.info.android.window;
+    }
