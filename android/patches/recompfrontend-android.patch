+            switch (e.type) {
+            case EventType::Click:
+                if (on_press) {
+                    on_press();
+                }
+                break;
+            case EventType::Hover:
+                set_style_enabled(hover_state, std::get<EventHover>(e.variant).active);
+                if (std::get<EventHover>(e.variant).active && on_focus) {
+                    on_focus();
+                }
+                break;
+            case EventType::Focus:
+                set_style_enabled(focus_state, std::get<EventFocus>(e.variant).active);
+                if (std::get<EventFocus>(e.variant).active) {
+                    scroll_into_view();
+                    if (on_focus) {
+                        on_focus();
+                    }
+                }
+                break;
+            default:
+                break;
+            }
+        }
+        std::string_view get_type_name() override { return "LayoutButtonRow"; }
+    public:
+        LayoutButtonRow(ResourceId rid, Element *parent, const std::string &text,
+                std::function<void()> press, std::function<void()> focus) :
+            Element(rid, parent, Events(EventType::Click, EventType::Hover, EventType::Focus), "button", false),
+            on_press(std::move(press)), on_focus(std::move(focus))
+        {
