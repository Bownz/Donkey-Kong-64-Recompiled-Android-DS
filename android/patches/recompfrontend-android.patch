diff --git a/recompui/src/composites/ui_menu_bar.cpp b/recompui/src/composites/ui_menu_bar.cpp
new file mode 100644
index 0000000..4050818
--- /dev/null
+++ b/recompui/src/composites/ui_menu_bar.cpp
@@ -0,0 +1,256 @@
+// Android: the in-game menu bar. The menu button opens a slim bar across the top of the
+// screen (in the bottom screen's DK style) instead of the full settings window; the bar opens
+// Settings or Mods in the settings window, or quits. Like the Dusklight port's.
+#ifdef __ANDROID__
+
+#include <algorithm>
+#include <chrono>
+#include "recompui.h"
+#include "recompui/config.h"
+#include "elements/ui_element.h"
+#include "elements/ui_label.h"
+
+namespace recompui {
+
+namespace {
+    const Color wood{122, 78, 38, 255};
+    const Color wood_edge{58, 30, 6, 255};
+    const Color tan{232, 213, 168, 255};
+    const Color cream{255, 244, 214, 255};
+    const Color banana{249, 214, 72, 255};
+
+    ContextId menu_bar_context{};
+    bool menu_bar_ready = false;
+
+    void close_menu_bar_animated();
+
+    // One entry on the bar: chunky capitals, banana yellow in a rounded outline when focused.
+    class MenuBarItem : public Element {
+    private:
+        std::function<void()> on_press;
+        Style hover_style;
+        Style focus_style;
+    protected:
+        void process_event(const Event &e) override {
+            switch (e.type) {
+            case EventType::Click:
+                if (on_press) {
+                    on_press();
+                }
+                break;
+            case EventType::MenuAction: {
+                // B on the bar closes it (the root also listens; closing twice is harmless).
+                MenuAction action = std::get<EventMenuAction>(e.variant).action;
+                if (action == MenuAction::Back || action == MenuAction::Toggle) {
+                    close_menu_bar_animated();
+                }
+                break;
+            }
+            case EventType::Hover:
+                set_style_enabled(hover_state, std::get<EventHover>(e.variant).active);
+                break;
+            case EventType::Focus:
+                set_style_enabled(focus_state, std::get<EventFocus>(e.variant).active);
+                break;
+            default:
+                break;
+            }
+        }
+        std::string_view get_type_name() override { return "MenuBarItem"; }
+    public:
+        MenuBarItem(ResourceId rid, Element *parent, const std::string &text, std::function<void()> press) :
+            Element(rid, parent, Events(EventType::Click, EventType::Hover, EventType::Focus, EventType::MenuAction), "button", false),
+            on_press(std::move(press))
+        {
+            set_cursor(Cursor::Pointer);
+            set_focusable(true);
+            set_tab_index_auto();
+            set_padding_top(12.0f);
+            set_padding_bottom(8.0f);
+            set_padding_left(22.0f);
+            set_padding_right(22.0f);
+            set_border_width(3.0f);
+            set_border_radius(16.0f);
+            // Every entry is a button (darker wood with a soft edge), not just the selected one.
+            set_border_color(Color{168, 128, 72, 140});
+            set_background_color(Color{62, 38, 16, 210});
+            set_color(tan);
+            hover_style.set_color(cream);
+            hover_style.set_background_color(Color{96, 62, 28, 230});
+            focus_style.set_color(banana);
+            focus_style.set_border_color(banana);
+            focus_style.set_background_color(Color{42, 20, 4, 240});
+            add_style(&hover_style, { hover_state });
+            add_style(&focus_style, { focus_state });
+
+            ContextId context = get_current_context();
+            Label *label = context.create_element<Label>(this, text, theme::Typography::Header3);
+            label->set_font_family("Luckiest Guy");
+            label->set_font_weight(400);
+            label->set_font_size(30.0f);
+            label->set_letter_spacing(1.0f);
+        }
+    };
+
+    // The bar's root: closes on Back / the menu button. The bar slides down from the top of
+    // the screen when it opens and back up when it closes.
+    constexpr float slide_ms = 180.0f;
+
+    class MenuBarRoot : public Element {
+    private:
+        enum class Anim { None, Opening, Closing };
+        Anim anim = Anim::None;
+        std::chrono::steady_clock::time_point anim_start;
+
+        // f: 0 = hidden above the screen, 1 = fully down.
+        void apply(float f) {
+            if (bar != nullptr) {
+                // Moved with "top" rather than a transform: with a transform, parts of the bar
+                // (e.g. behind QUIT) weren't redrawn until hovered.
+                float h = bar->get_client_height() / std::max(bar->get_dp_to_pixel_ratio(), 0.01f);
+                if (h <= 0.0f) {
+                    h = 80.0f;
+                }
+                bar->set_top(-(h + 8.0f) * (1.0f - f), Unit::Dp);
+            }
+            set_background_color(Color{0, 0, 0, static_cast<uint8_t>(90.0f * f)});
+        }
+    protected:
+        void process_event(const Event &e) override {
+            if (e.type == EventType::MenuAction) {
+                MenuAction action = std::get<EventMenuAction>(e.variant).action;
+                if (action == MenuAction::Back || action == MenuAction::Toggle) {
+                    slide_up();
+                }
+            } else if (e.type == EventType::Update) {
+                // Runs every frame (like the settings window's), so opening the bar never
+                // has to open this UI context from inside another one.
+                queue_update();
+                if (anim == Anim::None) {
+                    return;
+                }
+                float t = std::chrono::duration<float, std::milli>(std::chrono::steady_clock::now() - anim_start).count() / slide_ms;
+                if (t > 1.0f) {
+                    t = 1.0f;
+                }
+                if (anim == Anim::Opening) {
+                    apply(1.0f - (1.0f - t) * (1.0f - t) * (1.0f - t));   // ease out
+                } else {
+                    apply(1.0f - t * t);                                   // ease in
+                }
+                if (t >= 1.0f) {
+                    const bool closing = anim == Anim::Closing;
+                    anim = Anim::None;
+                    if (closing) {
+                        recompui::hide_context(menu_bar_context);
+                    }
+                }
+            }
+        }
+        std::string_view get_type_name() override { return "MenuBarRoot"; }
+    public:
+        Element *bar = nullptr;
+
+        MenuBarRoot(ResourceId rid, Element *parent) :
+            Element(rid, parent, Events(EventType::MenuAction, EventType::Update), "div", false) {}
+
+        void slide_down() {
+            anim = Anim::Opening;
+            anim_start = std::chrono::steady_clock::now();
+            apply(0.0f);
+        }
+
+        void slide_up() {
+            if (anim == Anim::Closing) {
+                return;
+            }
+            anim = Anim::Closing;
+            anim_start = std::chrono::steady_clock::now();
+        }
+
+        // Straight away, e.g. when the settings window opens over it.
+        void hide_now() {
+            anim = Anim::None;
+            apply(1.0f);
+            recompui::hide_context(menu_bar_context);
+        }
+    };
+
+    MenuBarRoot *menu_bar_root = nullptr;
+
+    void close_menu_bar_animated() {
+        if (menu_bar_root != nullptr) {
+            menu_bar_root->slide_up();
+        }
+    }
+
+    void open_settings_tab(const std::string &tab) {
+        menu_bar_root->hide_now();
+        recompui::config::set_tab(tab);
+        recompui::config::open();
+    }
+}
+
+void init_menu_bar_context() {
+    ContextId context = create_context();
+    context.open();
+    menu_bar_context = context;
+
+    MenuBarRoot *root = context.create_element<MenuBarRoot>(context.get_root_element());
+    root->set_position(Position::Absolute);
+    root->set_top(0);
+    root->set_left(0);
+    root->set_right(0);
+    root->set_bottom(0);
+    root->set_background_color(Color{0, 0, 0, 90});
+
+    Element *bar = context.create_element<Element>(root);
+    bar->set_position(Position::Absolute);
+    bar->set_top(0);
+    bar->set_left(0);
+    bar->set_right(0);
+    bar->set_display(Display::Flex);
+    bar->set_flex_direction(FlexDirection::Row);
+    bar->set_align_items(AlignItems::Center);
+    bar->set_gap(6.0f);
+    bar->set_padding_top(10.0f);
+    bar->set_padding_bottom(10.0f);
+    bar->set_padding_left(24.0f);
+    bar->set_padding_right(24.0f);
+    bar->set_background_color(wood);
+    bar->set_border_bottom_width(4.0f);
+    bar->set_border_bottom_color(wood_edge);
+    bar->set_as_navigation_container(NavigationType::Horizontal);
+    root->bar = bar;
+    menu_bar_root = root;
+
+    MenuBarItem *settings = context.create_element<MenuBarItem>(bar, "SETTINGS", []() { open_settings_tab(config::general::id); });
+    context.create_element<MenuBarItem>(bar, "MODS", []() { open_settings_tab(config::mods::id); });
+    context.create_element<MenuBarItem>(bar, "QUIT", []() {
+        menu_bar_root->hide_now();
+        recompui::open_quit_game_prompt();
+    });
+    Element *spacer = context.create_element<Element>(bar);
+    spacer->set_flex_grow(1.0f);
+    context.create_element<MenuBarItem>(bar, "X", []() { menu_bar_root->slide_up(); });
+
+    root->queue_update();   // starts its every-frame update
+    context.set_autofocus_element(settings);
+    context.close();
+    menu_bar_ready = true;
+}
+
+bool open_menu_bar() {
+    if (!menu_bar_ready) {
+        return false;
+    }
+    if (!recompui::is_context_shown(menu_bar_context)) {
+        menu_bar_root->slide_down();
+        recompui::show_context(menu_bar_context, "");
+    }
+    return true;
+}
+
+} // namespace recompui
+
+#endif
