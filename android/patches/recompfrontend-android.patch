+        const float x = side == 0 ? 62.0f : 262.0f, y = side == 0 ? 98.0f : 196.0f;
+        Element *ring = part(x, y, 80.0f, 80.0f, 40.0f, "", 2, side, 16.0f);
+        Element *dot = box(ring, 20.0f, 20.0f, 34.0f, 34.0f, 17.0f);
+        dot->set_background_color(part_edge);
+        stick_dots[side] = dot;
+        (void)ring;
+    }
+    part(152.0f, 196.0f, 30.0f, 30.0f, 6.0f, "", 0, SDL_CONTROLLER_BUTTON_DPAD_UP, 14.0f);
+    part(152.0f, 256.0f, 30.0f, 30.0f, 6.0f, "", 0, SDL_CONTROLLER_BUTTON_DPAD_DOWN, 14.0f);
+    part(122.0f, 226.0f, 30.0f, 30.0f, 6.0f, "", 0, SDL_CONTROLLER_BUTTON_DPAD_LEFT, 14.0f);
+    part(182.0f, 226.0f, 30.0f, 30.0f, 6.0f, "", 0, SDL_CONTROLLER_BUTTON_DPAD_RIGHT, 14.0f);
+
+    const SDL_GameControllerButton faces[4] = { SDL_CONTROLLER_BUTTON_A, SDL_CONTROLLER_BUTTON_B, SDL_CONTROLLER_BUTTON_X, SDL_CONTROLLER_BUTTON_Y };
+    const char *letters[4] = { "A", "B", "X", "Y" };
+    const char *shapes[4] = { "✕", "○", "□", "△" };
+    const float fx[4] = { 345.0f, 300.0f, 390.0f, 345.0f };   // top, left, right, bottom
+    const float fy[4] = { 92.0f, 132.0f, 132.0f, 172.0f };
+    for (int i = 0; i < 4; i++) {
+        const int p = face_position(faces[i], style);
+        part(fx[p], fy[p], 44.0f, 44.0f, 22.0f, ps ? shapes[i] : letters[i], 0, faces[i], ps ? 22.0f : 24.0f);
+    }
+    part(176.0f, 118.0f, 44.0f, 24.0f, 12.0f, nin ? "−" : "", 0, SDL_CONTROLLER_BUTTON_BACK, 18.0f);
+    part(240.0f, 118.0f, 44.0f, 24.0f, 12.0f, nin ? "+" : "", 0, SDL_CONTROLLER_BUTTON_START, 18.0f);
+
+    Label *caption = context.create_element<Label>(parent, "Press a button to see it light up", theme::Typography::LabelMD);
+    caption->set_display(Display::Block);
+    caption->set_text_align(TextAlign::Center);
+    caption->set_margin_top(14.0f);
+    caption->set_font_weight(700);
+    caption->set_color(Color{232, 213, 168, 200});
+    highlight_face_buttons(recompinput::GameInput::COUNT);
+}
+
+void ConfigPageControls::highlight_face_buttons(recompinput::GameInput input_id) {
+    for (auto &p : pad_parts) {
+        p.bound = false;
+    }
+    if (input_id == recompinput::GameInput::COUNT || selected_profile_index < 0) {
+        return;
+    }
+    for (int j = 0; j < recompinput::num_bindings_per_input; j++) {
+        recompinput::InputField field = recompinput::profiles::get_input_binding(selected_profile_index, input_id, j);
+        for (auto &p : pad_parts) {
+            if (field.input_type == recompinput::InputType::ControllerDigital && p.type == 0 && p.id == field.input_id) {
+                p.bound = true;
+            } else if (field.input_type == recompinput::InputType::ControllerAnalog) {
+                const int axis = std::abs(field.input_id) - 1;
+                if (p.type == 1 && p.id == axis) {
+                    p.bound = true;
+                } else if (p.type == 2 && p.id == (axis <= SDL_CONTROLLER_AXIS_LEFTY ? 0 : 1) && axis <= SDL_CONTROLLER_AXIS_RIGHTY) {
+                    p.bound = true;
+                }
+            }
+        }
+    }
+}
+
+// Every frame: which parts are pressed, and where the sticks are.
+void ConfigPageControls::update_controller_picture() {
+    if (pad_parts.empty()) {
+        return;
+    }
+    SDL_GameController *c = first_controller();
+    for (auto &p : pad_parts) {
+        bool pressed = false;
+        if (c != nullptr) {
+            if (p.type == 0) {
+                pressed = SDL_GameControllerGetButton(c, static_cast<SDL_GameControllerButton>(p.id)) != 0;
+            } else if (p.type == 1) {
+                pressed = SDL_GameControllerGetAxis(c, static_cast<SDL_GameControllerAxis>(p.id)) > 12000;
+            } else {
+                const SDL_GameControllerAxis ax = p.id == 0 ? SDL_CONTROLLER_AXIS_LEFTX : SDL_CONTROLLER_AXIS_RIGHTX;
+                const SDL_GameControllerAxis ay = p.id == 0 ? SDL_CONTROLLER_AXIS_LEFTY : SDL_CONTROLLER_AXIS_RIGHTY;
+                const float x = SDL_GameControllerGetAxis(c, ax) / 32768.0f;
+                const float y = SDL_GameControllerGetAxis(c, ay) / 32768.0f;
+                pressed = SDL_GameControllerGetButton(c, p.id == 0 ? SDL_CONTROLLER_BUTTON_LEFTSTICK : SDL_CONTROLLER_BUTTON_RIGHTSTICK) != 0
+                    || (x * x + y * y) > 0.25f;
+                if (stick_dots[p.id] != nullptr) {
+                    stick_dots[p.id]->set_left(20.0f + x * 18.0f);
+                    stick_dots[p.id]->set_top(20.0f + y * 18.0f);
+                }
+            }
+        }
+        const int state = (pressed ? 2 : 0) | (p.bound ? 1 : 0);
+        if (state == p.last_state) {
+            continue;
+        }
+        p.last_state = state;
+        p.el->set_background_color(pressed ? lit_fill : part_idle);
+        p.el->set_border_color(p.bound ? lit_fill : part_edge);
+        p.label->set_color(pressed ? lit_text : (p.bound ? lit_fill : part_text));
+        if (p.type == 2 && stick_dots[p.id] != nullptr) {
+            stick_dots[p.id]->set_background_color(pressed ? lit_text : part_edge);
+        }
+    }
 }
+#endif
 
 
 } // namespace recompui
