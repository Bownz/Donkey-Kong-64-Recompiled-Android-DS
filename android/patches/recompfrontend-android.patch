+void ConfigPageOptionsMenu::render_layout_options() {
+    ContextId context = recompui::get_current_context();
+    Element *body_left = get_body()->get_left();
+    body_left->clear_children();
+    body_left->set_padding(0.0f);
+    body_left->set_display(Display::Block);
+    body_left->set_position(Position::Relative);
+    body_left->set_height(100.0f, Unit::Percent);
+
+    auto scroll = context.create_element<Element>(body_left, 0, "div", false);
+    scroll->set_display(Display::Block);
+    scroll->set_width(100.0f, Unit::Percent);
+    scroll->set_min_height(100.0f, Unit::Percent);
+    scroll->set_max_height(100.0f, Unit::Percent);
+    scroll->set_padding(16.0f);
+    scroll->set_overflow_y(Overflow::Auto);
+    scroll->set_as_navigation_container(NavigationType::Vertical);
+
+    config_option_elements.clear();
+    element_configs.clear();
+    used_configs.clear();
+
+    bool first_header = true;
+    for (const auto &entry : *layout) {
+        switch (entry.kind) {
+        case recompui::config::LayoutEntry::Kind::Header: {
+            Label *header = context.create_element<Label>(scroll, entry.text, theme::Typography::Header3);
+            header->set_text_transform(TextTransform::Uppercase);
+#ifdef __ANDROID__
+            header->set_font_family("Luckiest Guy");
+            header->set_font_weight(400);
+            header->set_font_size(24.0f);
+            header->set_letter_spacing(1.0f);
+            header->set_color(Color{232, 213, 168, 170});
+#endif
+            header->set_display(Display::Block);
+            header->set_margin_top(first_header ? 4.0f : 22.0f);
+            header->set_margin_bottom(10.0f);
+            header->set_padding_left(10.0f);
+            first_header = false;
+            break;
+        }
+        case recompui::config::LayoutEntry::Kind::Button: {
+            const std::string description = entry.description;
+            context.create_element<LayoutButtonRow>(scroll, entry.text, entry.on_press, [this, description]() {
+                description_option_id.clear();
+                description_config = nullptr;
+                set_description_text(description);
+            });
+            break;
+        }
+        case recompui::config::LayoutEntry::Kind::Option: {
+            recomp::config::Config *cfg = &recompui::config::get_config(entry.config_id);
+            if (!cfg->has_option(entry.option_id)) {
+                break;
+            }
+            const auto &schema = cfg->get_config_schema();
+            size_t index = 0;
+            while (index < schema.options.size() && schema.options[index].id != entry.option_id) {
+                index++;
+            }
+            if (index >= schema.options.size()) {
+                break;
+            }
+            if (std::find(used_configs.begin(), used_configs.end(), cfg) == used_configs.end()) {
+                used_configs.push_back(cfg);
+            }
+            set_option_value_t set_value = [cfg](const std::string &option_id, recomp::config::ConfigValueVariant value) {
+                cfg->set_option_value(option_id, value);
+            };
+            on_option_hover_t hover = [this, cfg](const std::string &option_id) {
+                if (description_container) {
+                    description_option_id = option_id;
+                    description_config = cfg;
+                    set_description_text(cfg->get_option(option_id).description);
+                }
+            };
+            ConfigOptionElement *element = nullptr;
+            switch (schema.options[index].type) {
+            case recomp::config::ConfigOptionType::Enum:
+                element = context.create_element<ConfigOptionEnum>(scroll, entry.option_id, index, cfg, set_value, hover);
+                break;
+            case recomp::config::ConfigOptionType::Number:
+                element = context.create_element<ConfigOptionNumber>(scroll, entry.option_id, index, cfg, set_value, hover);
+                break;
+            case recomp::config::ConfigOptionType::String:
+                element = context.create_element<ConfigOptionString>(scroll, entry.option_id, index, cfg, set_value, hover);
+                break;
+            case recomp::config::ConfigOptionType::Bool:
+                element = context.create_element<ConfigOptionBool>(scroll, entry.option_id, index, cfg, set_value, hover);
+                break;
+            default:
+                break;
+            }
+            if (element != nullptr) {
+                element->update_disabled();
+                element->update_hidden();
+                config_option_elements.push_back(element);
+                element_configs.push_back(cfg);
+            }
+            break;
+        }
+        }
+    }
+}
+
 } // namespace recompui
