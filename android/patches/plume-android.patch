+        surfaceCreateInfo.window = window;
+        VkResult res = vkCreateAndroidSurfaceKHR(renderInterface->instance, &surfaceCreateInfo, nullptr, &surface);
+        if (res != VK_SUCCESS) {
+            fprintf(stderr, "vkCreateAndroidSurfaceKHR (recreate) failed with error code 0x%X.\n", res);
+            surface = VK_NULL_HANDLE;
+            return false;
+        }
+
+        // Presentation support is per surface; the queue family hasn't changed, but check.
+        VkBool32 presentSupported = VK_FALSE;
+        vkGetPhysicalDeviceSurfaceSupportKHR(commandQueue->device->physicalDevice, commandQueue->familyIndex, surface, &presentSupported);
+        if (!presentSupported) {
+            fprintf(stderr, "Recreated surface does not support presentation.\n");
+            return false;
+        }
+
+        desc.renderWindow = window;
+        return true;
+    }
