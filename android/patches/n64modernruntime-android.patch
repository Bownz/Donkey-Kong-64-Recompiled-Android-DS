+// Android: per-thread "nice" values (apps may raise their own threads' priority this way).
+// The VI thread paces the whole game and the game threads build each frame, so they run
+// ahead of background work such as RT64's shader compilation.
+void ultramodern::set_native_thread_priority(ThreadPriority pri) {
+    int nice = 0;
+    switch (pri) {
+        case ThreadPriority::Low: nice = 5; break;
+        case ThreadPriority::Normal: nice = 0; break;
+        case ThreadPriority::High: nice = -4; break;
+        case ThreadPriority::VeryHigh: nice = -8; break;
+        case ThreadPriority::Critical: nice = -10; break;
+        default: break;
+    }
+    setpriority(PRIO_PROCESS, gettid(), nice);
+}
