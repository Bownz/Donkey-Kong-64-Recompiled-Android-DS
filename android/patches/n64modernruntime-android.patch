+    const size_t page_size = (size_t)getpagesize();
+    const uintptr_t first = ((uintptr_t)target_func / page_size) * page_size;
+    const uintptr_t last = (((uintptr_t)target_func + patch_span - 1) / page_size) * page_size;
+    for (uintptr_t page = first; page <= last; page += page_size) {
+        if (mprotect((void*)page, page_size, PROT_READ | PROT_EXEC) != 0) {
+            fprintf(stderr, "Mod patch: couldn't make code page %p executable (errno %d)\n", (void*)page, errno);
+        }
+    }
+    // ARM: make the new instructions visible to instruction fetch.
+    __builtin___clear_cache((char*)target_func, (char*)target_func + patch_span);
+}
