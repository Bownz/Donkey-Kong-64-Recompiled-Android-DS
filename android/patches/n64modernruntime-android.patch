+// Android: the patched function's code is in libmain.so, mapped from the APK. Newer Android
+// (seen on Android 17) doesn't let an app make such a page executable again after writing
+// to it, so the old mprotect RW -> RX left it non-executable and the game crashed the next
+// time it ran code on that page. Instead each page the patch touches is swapped for an
+// anonymous copy of itself (which apps may make executable, as JITs do), then patched.
+// A patch is at most 16 bytes; this covers the pages of the first 32 bytes.
+static constexpr size_t patch_span = 32;
+
+void unprotect(void* target_func, uint64_t* old_flags) {
+    const size_t page_size = (size_t)getpagesize();
+    const uintptr_t first = ((uintptr_t)target_func / page_size) * page_size;
+    const uintptr_t last = (((uintptr_t)target_func + patch_span - 1) / page_size) * page_size;
+    std::vector<uint8_t> copy(page_size);
+    for (uintptr_t page = first; page <= last; page += page_size) {
+        memcpy(copy.data(), (void*)page, page_size);
+        void* mapped = mmap((void*)page, page_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+        if (mapped == MAP_FAILED) {
+            fprintf(stderr, "Mod patch: couldn't remap code page %p (errno %d)\n", (void*)page, errno);
+            mprotect((void*)page, page_size, PROT_READ | PROT_WRITE);
+            continue;
+        }
+        memcpy((void*)page, copy.data(), page_size);
+    }
+    *old_flags = 0;
+}
+
+void protect(void* target_func, uint64_t old_flags) {
